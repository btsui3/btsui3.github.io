---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { Content } = await render(post);
const words = (post.body ?? '').split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 220));
---

<Base title={post.data.title} description={post.data.description}>
  <article class="wrap post">
    <a class="back label" href="/blog/">← Writing</a>
    <header>
      <p class="label meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        &nbsp;·&nbsp; {minutes} min read
        {post.data.draft && <b>&nbsp;·&nbsp; Draft</b>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer>
      <a class="btn" href="/blog/">← More posts</a>
    </footer>
  </article>
</Base>

<style>
  .post {
    max-width: 760px;
    padding-block: 140px 100px;
  }
  .back {
    text-decoration: none;
  }
  header {
    margin: 34px 0 44px;
    padding-bottom: 34px;
    border-bottom: 1px solid var(--rule-strong);
  }
  h1 {
    font-size: clamp(34px, 5.4vw, 60px);
    margin: 16px 0 18px;
  }
  .lede {
    font-size: 20px;
    color: var(--ink-soft);
    margin: 0;
  }
  footer {
    margin-top: 60px;
    padding-top: 30px;
    border-top: 1px solid var(--rule);
  }

  .prose {
    font-size: 18px;
    line-height: 1.72;
  }
  .prose :global(h2) {
    font-size: 34px;
    margin: 2em 0 0.6em;
  }
  .prose :global(h3) {
    font-size: 25px;
    margin: 1.8em 0 0.5em;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.25em;
  }
  .prose :global(li) {
    margin-bottom: 0.4em;
  }
  .prose :global(a) {
    color: var(--accent);
  }
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding-left: 20px;
    border-left: 2px solid var(--accent);
    color: var(--ink-soft);
    font-size: 20px;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: 5px;
    padding: 1px 5px;
  }
  .prose :global(pre) {
    margin: 1.6em 0;
    padding: 18px 20px;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    overflow-x: auto;
    font-size: 14.5px;
    line-height: 1.6;
  }
  .prose :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
  }
  .prose :global(img) {
    border-radius: var(--radius);
    margin: 1.6em 0;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px dashed var(--rule-strong);
    margin: 2.4em 0;
  }
</style>
