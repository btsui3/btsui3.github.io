---
import { rack } from '../data/site';
---

<section class="section rack" id="skills" aria-labelledby="rack-title">
  <div class="wrap">
    <header class="section-head">
      <p class="label" data-reveal><b>03</b> &nbsp;/&nbsp; Skills</p>
      <h2 id="rack-title" data-reveal>What I <em>work with</em></h2>
      <p data-reveal>
        The languages, frameworks and platforms I use, grouped by where they sit in the stack.
      </p>
    </header>

    <div class="groups">
      {
        rack.map((g, i) => (
          <section class="group" data-reveal style={`--delay: ${i * 80}ms`}>
            <header>
              <span class="num label">
                <b>{String(i + 1).padStart(2, '0')}</b>
              </span>
              <h3>{g.group}</h3>
              <p class="note">{g.note}</p>
            </header>
            <ul>
              {g.items.map((item) => (
                <li>
                  <span class="biner" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .rack {
    background: var(--bg-sunk);
    border-block: 1px solid var(--rule);
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .group {
    background: var(--bg);
    padding: clamp(22px, 2.6vw, 32px);
  }
  header {
    margin-bottom: 20px;
  }
  .group h3 {
    font-size: 28px;
    margin: 10px 0 4px;
  }
  .note {
    color: var(--muted);
    font-size: 14.5px;
    margin: 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 0;
    border-top: 1px dashed var(--rule);
    font-size: 16px;
    transition: color 0.2s, padding-left 0.25s;
  }
  li:hover {
    color: var(--accent);
    padding-left: 6px;
  }
  .biner {
    width: 6px;
    height: 6px;
    border: 1.5px solid var(--muted);
    border-radius: 50%;
    flex: none;
    transition: border-color 0.2s, background-color 0.2s;
  }
  li:hover .biner {
    border-color: var(--accent);
    background: var(--accent);
  }
</style>
