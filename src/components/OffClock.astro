---
import { Image } from 'astro:assets';
import { offClock } from '../data/site';
import bouldering from '../assets/photos/bouldering.png';
import snow from '../assets/photos/snow-run.jpg';
import squamish from '../assets/photos/squamish.jpg';
import spain from '../assets/photos/spain.jpg';
import guadalajara from '../assets/photos/guadalajara.jpg';

// Swap, add or remove photos here. `caption` prints under each one.
const photos = [
  { src: spain, alt: 'A climber on an orange cliff high above a reservoir and pine forest', caption: 'Spain', w: 620 },
  { src: squamish, alt: 'A climber on a granite arete against a deep blue sky', caption: 'Squamish, BC', w: 620 },
  { src: bouldering, alt: 'Ben bouldering on a sandstone boulder above a stack of crash pads', caption: 'Bouldering', w: 240 },
  { src: guadalajara, alt: 'A climber crossing a limestone roof', caption: 'Limestone roof', w: 620 },
  { src: snow, alt: 'Ben running through fresh snow beside a dog in a green jacket', caption: 'First snow', w: 520 },
];
---

<section class="section" id="off-the-clock" aria-labelledby="off-title">
  <div class="wrap layout">
    <header class="section-head">
      <p class="label" data-reveal><b>04</b> &nbsp;/&nbsp; Outside</p>
      <h2 id="off-title" data-reveal>Off the <em>clock</em></h2>
      <p data-reveal>{offClock.body}</p>
    </header>

    <ul class="prints">
      {
        photos.map((p, i) => (
          <li class="print" data-reveal style={`--delay: ${i * 90}ms; --tilt: ${[-3, 2.2, -1.6, 3, -2.4][i % 5]}deg`}>
            <figure>
              <Image src={p.src} alt={p.alt} width={p.w} loading="lazy" />
              <figcaption>{p.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section-head {
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .prints {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(14px, 2vw, 26px);
    align-items: center;
  }
  .print {
    grid-column: span 4;
  }
  .print:nth-child(3) {
    grid-column: span 2;
  }
  .print:nth-child(4) {
    grid-column: 2 / span 5;
  }
  .print:nth-child(5) {
    grid-column: span 3;
  }
  .print:nth-child(1),
  .print:nth-child(2) {
    grid-column: span 5;
  }
  figure {
    margin: 0;
    padding: 10px 10px 0;
    background: #f7f3ea;
    color: #2a2a26;
    border-radius: 3px;
    box-shadow: var(--shadow);
    transform: rotate(var(--tilt));
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .print:hover figure {
    transform: rotate(0deg) scale(1.03);
  }
  figure :global(img) {
    width: 100%;
    height: auto;
    border-radius: 1px;
  }
  figcaption {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 10px 2px 11px;
  }
  @media (max-width: 760px) {
    .prints {
      grid-template-columns: repeat(2, 1fr);
    }
    .print,
    .print:nth-child(n) {
      grid-column: span 1;
    }
    .print:nth-child(1) {
      grid-column: span 2;
    }
  }
</style>
