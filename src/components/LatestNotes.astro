---
import { getPosts, formatDate } from '../lib/posts';
const posts = (await getPosts()).slice(0, 3);
---

{
  posts.length > 0 && (
    <section class="section notes" aria-labelledby="notes-title">
      <div class="wrap">
        <header class="head">
          <div>
            <p class="label" data-reveal>
              <b>Log</b> &nbsp;/&nbsp; Writing
            </p>
            <h2 id="notes-title" data-reveal>
              Recent <em>writing</em>
            </h2>
          </div>
          <a class="btn" href="/blog/" data-reveal>
            All posts <span aria-hidden="true">→</span>
          </a>
        </header>
        <ul>
          {posts.map((post) => (
            <li data-reveal>
              <a href={`/blog/${post.id}/`}>
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <span class="title">{post.data.title}</span>
                <span class="desc">{post.data.description}</span>
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .notes {
    padding-top: 0;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 30px;
  }
  h2 {
    font-size: clamp(34px, 5.4vw, 64px);
    margin-top: 18px;
  }
  h2 em {
    font-style: normal;
    color: var(--accent);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }
  li a {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr) 30px;
    gap: 4px 24px;
    padding: 24px 4px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    transition: padding 0.3s, background-color 0.3s;
  }
  li a:hover {
    padding-inline: 16px;
    background: var(--bg-raised);
  }
  time {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
    padding-top: 8px;
    grid-row: span 2;
  }
  .title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.15;
  }
  .desc {
    grid-column: 2;
    color: var(--ink-soft);
    font-size: 16px;
  }
  .arrow {
    grid-column: 3;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--accent);
    transition: transform 0.3s;
  }
  li a:hover .arrow {
    transform: translateX(4px);
  }
  @media (max-width: 640px) {
    li a {
      grid-template-columns: minmax(0, 1fr) 24px;
    }
    time {
      grid-row: auto;
      grid-column: 1;
      padding: 0;
    }
    .desc {
      grid-column: 1;
    }
    .arrow {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
  }
</style>
