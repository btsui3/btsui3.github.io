---
import { profile } from '../data/site';
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="label" data-reveal><b>05</b> &nbsp;/&nbsp; Contact</p>
    <h2 id="contact-title" data-reveal>
      Let's <em>talk.</em>
    </h2>
    <p class="lede" data-reveal>
      If you are building something interesting and need a full-stack engineer, I would like to hear about it. The fastest way to reach me is a message on LinkedIn.
    </p>
    <div class="actions" data-reveal>
      <a class="btn primary" href={profile.links.linkedin} target="_blank" rel="noopener">
        Message me on LinkedIn <span aria-hidden="true">↗</span>
      </a>
      <a class="btn" href={profile.links.github} target="_blank" rel="noopener">
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    text-align: left;
  }
  h2 {
    font-size: clamp(44px, 9vw, 128px);
    line-height: 0.95;
    margin: 22px 0 28px;
  }
  h2 em {
    font-style: normal;
    color: var(--accent);
  }
  .lede {
    max-width: 52ch;
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--ink-soft);
    margin-bottom: 30px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
